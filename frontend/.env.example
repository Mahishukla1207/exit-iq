# ExitIQ Frontend Environment Configuration Example
# Copy to .env.local for local overrides or set in Vercel Project Settings > Environment Variables

# Backend HTTP API base URL (e.g., 'https://exitiq-backend.onrender.com/api/v1' for production, defaults to 'http://localhost:8000/api/v1' locally)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Continuous CCTV/MJPEG stream URL (optional override, defaults to derived ${VITE_API_BASE_URL}/cv/stream)
# VITE_CV_STREAM_URL=http://localhost:8000/api/v1/cv/stream

# WebSocket URL (optional override, defaults to derived ws:// or wss:// from ${VITE_API_BASE_URL})
# VITE_WS_BASE_URL=ws://localhost:8000

# x402 Payment Gateway URL (defaults to 'http://localhost:4021')
# VITE_GATEWAY_URL=http://localhost:4021
